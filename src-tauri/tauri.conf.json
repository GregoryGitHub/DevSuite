{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Suite",
  "mainBinaryName": "dev-suite",
  "version": "1.2.0",
  "identifier": "com.todors.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dev Suite",
        "width": 370,
        "height": 530,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false,
        "maximizable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "DevSuite.Markdown",
        "description": "Documento Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "resources": {
      "icons/files/markdown.ico": "icons/markdown.ico",
      "icons/apps/notes.ico": "icons/notes.ico"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
