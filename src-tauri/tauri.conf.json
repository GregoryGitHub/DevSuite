{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Suite",
  "mainBinaryName": "dev-suite",
  "version": "1.0.0",
  "identifier": "com.todors.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dev Suite",
        "width": 370,
        "height": 530,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false,
        "maximizable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
